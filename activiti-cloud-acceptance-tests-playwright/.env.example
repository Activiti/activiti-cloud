# Copy to .env and adjust for your preview environment:
#   cp activiti-cloud-acceptance-tests-playwright/.env.example \
#      activiti-cloud-acceptance-tests-playwright/.env

# --- Preview / cluster (or run: npm run test:setup) ---
# ACCEPTANCE_ENV_NAME=activiti-tests  → namespace pr-activiti-tests-rabbit-n-d
# ACTIVITI_KUBECONFIG=~/Downloads/activiti.yaml
ACCEPTANCE_ENV_NAME=activiti-tests
PREVIEW_NAME=pr-activiti-tests-rabbit-n-d
CLUSTER_NAME=activiti
CLUSTER_DOMAIN=envalfresco.com
LOCAL_PORT=8080

# Apply cluster prerequisites automatically when something is missing (default: true).
# Skips rollouts when hostAliases, policies, and example-runtime-bundle image are already correct.
# Set to false if you manage the cluster yourself and only run: npm run cluster:prereqs once.
AUTO_CLUSTER_PREREQS=true

# Fail fast in global-setup if required BPMN keys are not deployed (default: true).
VERIFY_ACCEPTANCE_PROCESS_CATALOG=true

# Runtime-bundle image with full acceptance BPMN catalog. Leave unset to auto-resolve the newest
# activiti/example-runtime-bundle tag via scripts/resolve-docker-images.sh (recommended).
# ACCEPTANCE_RUNTIME_BUNDLE_IMAGE=activiti/example-runtime-bundle:latest
# ACCEPTANCE_RUNTIME_BUNDLE_USE_RESOLVED_TAG=true
# Auto-skipped for example-runtime-bundle; force on slim chart images:
# ACCEPTANCE_USE_SUPPLEMENTAL_PROCESSES=true

# Set to false to call GATEWAY_HOST directly (e.g. via /etc/hosts) instead of localhost port-forward
LOCAL_USE_PORT_FORWARD=true
# Port-forward target (traefik on CI-like clusters, ingress-nginx on Hyland aae clusters):
# PORT_FORWARD_NAMESPACE=default
# PORT_FORWARD_SERVICE=ingress-nginx-controller

# Parallel workers (default 4). Each worker gets unique process/task names + after-test cleanup.
# ACCEPTANCE_CLEANUP_VERBOSE=true  # optional: colored cleanup personas instead of Logger
PLAYWRIGHT_WORKERS=4

# --- CI detection (keep false for local runs) ---
CI=false
GITHUB_ACTIONS=false

# --- Gateway (auto-corrected from PREVIEW_NAME + CLUSTER_NAME if malformed) ---
GATEWAY_PROTOCOL=http
GATEWAY_HOST=gateway-pr-your-name-rabbit-n-d.your-cluster.envalfresco.com:8080

# --- SSO / Keycloak (bundled in preview — filled by npm run test:setup) ---
SSO_HOST=https://identity-pr-activiti-tests-rabbit-n-d.activiti.envalfresco.com/auth/realms/activiti/protocol/openid-connect/token
KEYCLOAK_REALM=activiti
KEYCLOAK_CLIENT_ID=activiti
# KEYCLOAK_CLIENT_SECRET=  # auto from secret activiti-keycloak-client in PREVIEW_NAME

# Seeded users (password "password" on standard preview installs):
# testuser, hruser, hradmin, processadminuser, ...

ACTIVITI_CLOUD_APPLICATION_NAME=default-app

# --- Users required per test project ---
# identity-adapter: TESTUSER
TESTUSER_USERNAME=testuser
TESTUSER_PASSWORD=password

# security-policies: HRUSER + HRADMIN
HRUSER_USERNAME=hruser
HRUSER_PASSWORD=password
HRADMIN_USERNAME=hradmin
HRADMIN_PASSWORD=password

# runtime / process-instance-actions: TESTUSER + HRUSER (headers) + TESTADMIN + PROCESSADMIN
TESTADMIN_USERNAME=testadmin
TESTADMIN_PASSWORD=password
PROCESSADMINUSER_USERNAME=processadminuser
PROCESSADMINUSER_PASSWORD=password

# DEBUG=pw:api
