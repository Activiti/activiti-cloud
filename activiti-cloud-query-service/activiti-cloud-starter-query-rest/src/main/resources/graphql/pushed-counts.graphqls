"""
A schema must have a Query type - this field exists only to satisfy that, for deployments
where nothing else supplies one (e.g. query-rest without notifications-graphql-service).
"""
type Query {
    _pushedCountsSchemaPlaceholder: Boolean
}

type Subscription {
    myTasks: PushedCount
    queuedTasks: PushedCount
    runningProcesses: PushedCount
}

type PushedCount {
    count: Int!
    asOf: String!
}
