{
  "name": "activiti-cloud-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright TypeScript tests for Activiti Cloud",
  "main": "index.js",
  "scripts": {
    "check:env": "tsx activiti-cloud-acceptance-tests-playwright/scripts/check-local-env.ts",
    "check:env:identity": "tsx activiti-cloud-acceptance-tests-playwright/scripts/check-local-env.ts identity",
    "check:env:security": "tsx activiti-cloud-acceptance-tests-playwright/scripts/check-local-env.ts security",
    "check:env:process": "tsx activiti-cloud-acceptance-tests-playwright/scripts/check-local-env.ts process",
    "port-forward": "activiti-cloud-acceptance-tests-playwright/scripts/start-port-forward.sh",
    "cluster:prereqs": "bash activiti-cloud-acceptance-tests-playwright/scripts/apply-cluster-prereqs.sh",
    "test:setup": "bash activiti-cloud-acceptance-tests-playwright/scripts/setup-acceptance-environment.sh",
    "kube:use": "bash activiti-cloud-acceptance-tests-playwright/scripts/use-kubeconfig.sh",
    "verify:process-catalog": "tsx activiti-cloud-acceptance-tests-playwright/scripts/verify-acceptance-process-catalog.ts",
    "kube:develop": "bash -c 'source activiti-cloud-acceptance-tests-playwright/scripts/use-develop-kubeconfig.sh && exec \"$SHELL\"'",
    "test": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts",
    "test:identity": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=identity-adapter",
    "test:security": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=security-policies",
    "test:process": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=process-instance-actions",
    "test:runtime": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=runtime",
    "test:runtime:process-instance": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=runtime-process-instance",
    "test:runtime:tasks": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=runtime-tasks",
    "test:all": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=all-tests",
    "test:smoke": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --grep @smoke",
    "test:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts",
    "test:identity:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=identity-adapter",
    "test:security:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=security-policies",
    "test:process:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --project=process-instance-actions",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "typescript",
    "activiti-cloud"
  ],
  "author": "michal.fidor@hyland.com",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "jwt-decode": "^4.0.0",
    "winston": "^3.14.2"
  }
}
