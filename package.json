{
  "name": "activiti-cloud-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright TypeScript tests for Activiti Cloud",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p activiti-cloud-acceptance-tests-playwright/tsconfig.json",
    "check:env": "tsx activiti-cloud-acceptance-tests-playwright/scripts/check-local-env.ts",
    "port-forward": "activiti-cloud-acceptance-tests-playwright/scripts/start-port-forward.sh",
    "cluster:prereqs": "bash activiti-cloud-acceptance-tests-playwright/scripts/apply-cluster-prereqs.sh",
    "test:setup": "bash activiti-cloud-acceptance-tests-playwright/scripts/setup-acceptance-environment.sh",
    "preview:delete": "bash activiti-cloud-acceptance-tests-playwright/scripts/delete-preview-namespace.sh",
    "kube:use": "bash activiti-cloud-acceptance-tests-playwright/scripts/use-kubeconfig.sh",
    "verify:process-catalog": "tsx activiti-cloud-acceptance-tests-playwright/scripts/verify-acceptance-process-catalog.ts",
    "test:destructive": "PLAYWRIGHT_INCLUDE_DESTRUCTIVE=true PLAYWRIGHT_WORKERS=1 playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/runtime/delete-actions.spec.ts",
    "test": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts",
    "test:all": "npm run test",
    "test:ci": "npm run test:all && npm run test:destructive",
    "test:identity": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/identity-adapter.spec.ts",
    "test:security": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/hruser-security-policies.spec.ts activiti-cloud-acceptance-tests-playwright/tests/hradmin-security-policies.spec.ts",
    "test:process": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/process-instance-actions.spec.ts",
    "test:runtime": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/runtime",
    "test:runtime:process-instance": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/runtime/process-instance",
    "test:runtime:tasks": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/runtime/task",
    "test:smoke": "playwright test --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts --grep @smoke",
    "test:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts",
    "test:identity:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/identity-adapter.spec.ts",
    "test:security:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/hruser-security-policies.spec.ts activiti-cloud-acceptance-tests-playwright/tests/hradmin-security-policies.spec.ts",
    "test:process:debug": "playwright test --debug --config=./activiti-cloud-acceptance-tests-playwright/playwright.config.ts activiti-cloud-acceptance-tests-playwright/tests/process-instance-actions.spec.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps",
    "matrix:rabbitmq:non-partitioned:default": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b rabbitmq -p non-partitioned -d default-destinations",
    "matrix:rabbitmq:partitioned:default": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b rabbitmq -p partitioned -d default-destinations",
    "matrix:kafka:non-partitioned:default": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b kafka -p non-partitioned -d default-destinations",
    "matrix:kafka:partitioned:default": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b kafka -p partitioned -d default-destinations",
    "matrix:kafka:partitioned:override": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b kafka -p partitioned -d override-destinations",
    "matrix:rabbitmq:non-partitioned:pdb": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b rabbitmq -p non-partitioned -d pdb",
    "matrix:rabbitmq:prefix:pdb": "bash activiti-cloud-acceptance-tests-playwright/scripts/run-matrix-item.sh -n ${npm_config_name:-local-dev} -b rabbitmq -p prefix -d pdb"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "typescript",
    "activiti-cloud"
  ],
  "author": "michal.fidor@hyland.com",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "graphql-ws": "^6.0.8",
    "jwt-decode": "^4.0.0",
    "winston": "^3.14.2",
    "ws": "^8.21.0"
  }
}
